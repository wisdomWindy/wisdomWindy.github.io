---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
  mobile?: boolean
}

const { headings, mobile = false } = Astro.props
const visibleHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3)
---

{mobile ? (
  <details class="toc-mobile">
    <summary>文章目录</summary>
    <ol>
      {visibleHeadings.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
    </ol>
  </details>
) : (
  <nav class="toc-desktop" aria-label="文章目录">
    <p>文章目录</p>
    <ol>
      {visibleHeadings.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
    </ol>
  </nav>
)}

<style>
  p, summary { margin: 0 0 12px; color: var(--ink); font-size: .8rem; font-weight: 750; }
  ol { margin: 0; padding: 0; list-style: none; }
  li + li { margin-top: 8px; }
  li.nested { padding-left: 12px; }
  a { color: var(--ink-muted); font-size: .76rem; line-height: 1.45; text-decoration: none; }
  a:hover { color: var(--brand); }
  .toc-mobile { display: none; margin: 0 0 34px; padding: 14px 16px; border-block: 1px solid var(--line); }
  .toc-mobile summary { margin: 0; cursor: pointer; }
  .toc-mobile[open] summary { margin-bottom: 13px; }
  @media (max-width: 999px) {
    .toc-mobile { display: block; }
    .toc-desktop { display: none; }
  }
</style>
