---
import { ArrowUpRight } from '@lucide/astro'
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '../lib/format'

interface Props {
  project: CollectionEntry<'projects'>
  eager?: boolean
}

const { project, eager = false } = Astro.props
const visibleTech = project.data.techStack.slice(0, 4)
---

<article
  class="project-card"
  data-project-card
  data-technologies={JSON.stringify(project.data.techStack.map((item) => item.toLocaleLowerCase('en-US')))}
>
  <a class="project-card__cover" href={`/projects/${project.id}/`} tabindex="-1" aria-hidden="true">
    <img
      src={project.data.cover.src}
      width="1200"
      height="750"
      alt={project.data.cover.alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <div class="project-card__body">
    <div class="project-card__meta">
      <time datetime={project.data.pubDate.toISOString()}>{project.data.pubDate.getUTCFullYear()}</time>
      <span>{formatDate(project.data.pubDate)}</span>
    </div>
    <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
    <p class="project-card__description">{project.data.description}</p>
    <ul class="tag-list" aria-label="技术栈">
      {visibleTech.map((technology) => <li>{technology}</li>)}
    </ul>
    <a class="project-card__link" href={`/projects/${project.id}/`}>
      查看案例 <ArrowUpRight aria-hidden="true" size={18} stroke-width={1.8} />
    </a>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--surface);
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .project-card:hover {
    border-color: var(--ink-muted);
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .project-card__cover {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--surface-subtle);
  }

  .project-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 180ms ease;
  }

  .project-card:hover .project-card__cover img {
    transform: scale(1.015);
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px;
  }

  .project-card__meta {
    display: flex;
    justify-content: space-between;
    color: var(--ink-muted);
    font-size: 0.76rem;
  }

  h3 {
    margin: 12px 0 8px;
    font-size: 1.28rem;
    line-height: 1.3;
    letter-spacing: 0;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--brand);
  }

  .project-card__description {
    display: -webkit-box;
    min-height: 3.4em;
    margin: 0 0 18px;
    overflow: hidden;
    color: var(--ink-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--ink-muted);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: auto;
    color: var(--brand);
    font-size: 0.88rem;
    font-weight: 750;
    text-decoration: none;
  }
</style>
