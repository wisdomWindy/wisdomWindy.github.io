---
interface Props {
  technologies: string[]
  total: number
}

const { technologies, total } = Astro.props
---

<div class="project-filter" data-project-filter data-total={total}>
  <div class="project-filter__controls" role="group" aria-label="按技术筛选项目">
    <button type="button" data-filter="all" aria-pressed="true">全部</button>
    {technologies.map((technology) => (
      <button type="button" data-filter={technology.toLocaleLowerCase('en-US')} aria-pressed="false">
        {technology}
      </button>
    ))}
  </div>
  <p class="project-filter__count" aria-live="polite">共 <span>{total}</span> 个项目</p>
  <p class="project-filter__empty" hidden>暂时没有匹配该技术的项目，可以切回“全部”继续浏览。</p>
</div>

<script>
  const setupProjectFilter = () => {
    const root = document.querySelector<HTMLElement>('[data-project-filter]')
    if (!root || root.dataset.ready === 'true') return
    root.dataset.ready = 'true'
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')]
    const cards = [...document.querySelectorAll<HTMLElement>('[data-project-card]')]
    const count = root.querySelector<HTMLElement>('.project-filter__count span')
    const empty = root.querySelector<HTMLElement>('.project-filter__empty')

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const selected = button.dataset.filter ?? 'all'
        let visibleCount = 0

        for (const card of cards) {
          const technologies = JSON.parse(card.dataset.technologies ?? '[]') as string[]
          const visible = selected === 'all' || technologies.includes(selected)
          card.hidden = !visible
          if (visible) visibleCount += 1
        }

        for (const candidate of buttons) {
          candidate.setAttribute('aria-pressed', String(candidate === button))
        }
        if (count) count.textContent = String(visibleCount)
        if (empty) empty.hidden = visibleCount > 0
      })
    }
  }

  setupProjectFilter()
  document.addEventListener('astro:page-load', setupProjectFilter)
</script>

<style>
  .project-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 30px;
  }

  .project-filter__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  button {
    min-height: 38px;
    padding: 7px 13px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--surface);
    color: var(--ink-muted);
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 700;
  }

  button:hover {
    border-color: var(--ink-muted);
    color: var(--ink);
  }

  button[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--surface);
  }

  .project-filter__count {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.86rem;
  }

  .project-filter__empty {
    flex-basis: 100%;
    padding: 28px 0;
    border-block: 1px solid var(--line);
    color: var(--ink-muted);
  }

  @media (max-width: 639px) {
    .project-filter__controls {
      width: calc(100% + 28px);
      margin-inline: -14px;
      padding-inline: 14px;
      overflow-x: auto;
      flex-wrap: nowrap;
      scrollbar-width: thin;
    }

    button {
      flex: 0 0 auto;
    }
  }
</style>
