---
import { render, type CollectionEntry } from 'astro:content'
import ProjectLayout from '../../layouts/ProjectLayout.astro'
import { getAdjacentEntries, getPublishedProjects } from '../../lib/content'

export async function getStaticPaths() {
  const projects = await getPublishedProjects()
  return projects.map((project) => ({ params: { slug: project.id }, props: { project, ...getAdjacentEntries(projects, project.id) } }))
}

interface Props {
  project: CollectionEntry<'projects'>
  previous?: CollectionEntry<'projects'>
  next?: CollectionEntry<'projects'>
}

const { project, previous, next } = Astro.props
const { Content } = await render(project)
---

<ProjectLayout project={project} previous={previous} next={next}><Content /></ProjectLayout>
