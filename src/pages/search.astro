---
import SearchExperience from '../components/SearchExperience.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="搜索" description="搜索 wisdomWindy 的技术文章与项目案例。" noindex>
  <header class="page-header section"><div class="search-width"><p class="eyebrow">Search</p><h1>搜索</h1><p>在文章与项目案例中查找技术、方法和实现细节。</p></div></header>
  <section class="section section--subtle"><div class="search-width"><SearchExperience /></div></section>
</BaseLayout>

<style>
  .search-width { width: min(calc(100% - 40px), 820px); margin-inline: auto; }
  .page-header { padding-bottom: 52px; }
  h1 { margin: 0; font-size: 5rem; line-height: 1; letter-spacing: 0; }
  .page-header p:last-child { max-width: 600px; margin: 20px 0 0; color: var(--ink-muted); }
  @media (max-width: 639px) { h1 { font-size: 3.2rem; } .search-width { width: min(calc(100% - 28px), 820px); } }
</style>
