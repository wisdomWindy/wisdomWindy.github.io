---
import { ArrowLeft } from '@lucide/astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="页面不存在" description="该页面不存在或已被移动。" noindex>
  <section class="not-found section">
    <div class="container not-found__inner">
      <p class="error-code" aria-hidden="true">404</p>
      <p class="eyebrow">Not Found</p>
      <h1>404 / 页面不存在</h1>
      <p>你访问的路径可能已移动、删除，或者链接中存在拼写问题。</p>
      <a class="button-link" href="/"><ArrowLeft aria-hidden="true" size={18} /> 返回首页</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { display: grid; min-height: calc(100svh - var(--header-height) - 164px); place-items: center; }
  .not-found__inner { max-width: 760px; text-align: center; }
  .error-code { margin: 0; color: var(--surface-strong); font-size: 13rem; font-weight: 850; line-height: .72; letter-spacing: 0; user-select: none; }
  h1 { margin: 18px 0 0; font-size: 3.5rem; line-height: 1.1; letter-spacing: 0; }
  .not-found__inner > p:not(.eyebrow, .error-code) { max-width: 520px; margin: 20px auto 28px; color: var(--ink-muted); }
  @media (max-width: 639px) { .error-code { font-size: 8rem; } h1 { font-size: 2.2rem; } }
</style>
